change the view bit modern

* {
    box-sizing: border-box;
}


:root {

    --bg: #f6f8fb;

    --sidebar: #111827;

    --sidebar-hover: #1f2937;

    --primary: #2563eb;

    --primary-hover: #1d4ed8;

    --text: #111827;

    --muted: #6b7280;

    --border: #e5e7eb;

    --card: #ffffff;

    --success: #16a34a;

    --danger: #dc2626;
}


body {

    margin: 0;

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: var(--bg);

    color: var(--text);
}


button,
input,
select,
textarea {

    font: inherit;
}


/* ==================================================
   APP
================================================== */

.app {

    display: flex;

    min-height: 100vh;
}


/* ==================================================
   SIDEBAR
================================================== */

.sidebar {

    width: 230px;

    background: var(--sidebar);

    color: white;

    padding: 22px 14px;

    display: flex;

    flex-direction: column;

    position: fixed;

    left: 0;

    top: 0;

    bottom: 0;
}


.logo {

    font-size: 20px;

    font-weight: 700;

    padding: 0 10px 24px;
}


.account-selector {

    margin-bottom: 20px;
}


.account-selector label {

    display: block;

    color: #9ca3af;

    font-size: 11px;

    margin: 0 8px 7px;
}


.account-selector select {

    width: 100%;

    background: #1f2937;

    color: white;

    border: 1px solid #374151;

    border-radius: 7px;

    padding: 9px;
}


nav {

    display: flex;

    flex-direction: column;

    gap: 4px;
}


.menu-item {

    border: 0;

    background: transparent;

    color: #cbd5e1;

    text-align: left;

    padding: 11px 12px;

    border-radius: 7px;

    cursor: pointer;
}


.menu-item:hover {

    background: var(--sidebar-hover);

    color: white;
}


.menu-item.active {

    background: var(--primary);

    color: white;
}


.sidebar-bottom {

    margin-top: auto;
}


.credentials-btn {

    width: 100%;

    border: 1px solid #374151;

    background: transparent;

    color: #d1d5db;

    padding: 10px;

    border-radius: 7px;

    cursor: pointer;
}


.credentials-btn:hover {

    background: #1f2937;

    color: white;
}


/* ==================================================
   MAIN
================================================== */

.main {

    margin-left: 230px;

    width: calc(100% - 230px);

    padding: 25px 30px;
}


.topbar {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 28px;
}


.topbar h1 {

    margin: 0 0 5px;

    font-size: 25px;
}


.connection-status {

    color: var(--muted);

    font-size: 13px;
}


.connection-status.connected {

    color: var(--success);

    font-weight: 600;
}


.region-box {

    display: flex;

    align-items: center;

    gap: 10px;
}


.region-box label {

    font-size: 13px;

    color: var(--muted);
}


.region-box select {

    border: 1px solid var(--border);

    background: white;

    border-radius: 7px;

    padding: 9px 12px;
}


/* ==================================================
   PAGES
================================================== */

.page {

    display: none;
}


.page.active {

    display: block;
}


.page-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 20px;
}


.page-header h2 {

    margin: 0 0 5px;

    font-size: 20px;
}


.page-header p {

    margin: 0;

    color: var(--muted);

    font-size: 13px;
}


/* ==================================================
   CARDS
================================================== */

.cards {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 16px;

    margin-bottom: 20px;
}


.card {

    background: white;

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 20px;
}


.card span {

    display: block;

    color: var(--muted);

    font-size: 13px;

    margin-bottom: 8px;
}


.card strong {

    font-size: 28px;
}


/* ==================================================
   BUTTONS
================================================== */

.primary,
.secondary,
.small-button,
.danger-button {

    border-radius: 7px;

    padding: 9px 14px;

    cursor: pointer;

    border: 0;
}


.primary {

    background: var(--primary);

    color: white;
}


.primary:hover {

    background: var(--primary-hover);
}


.secondary {

    background: white;

    color: var(--text);

    border: 1px solid var(--border);
}


.secondary:hover {

    background: #f9fafb;
}


/* ==================================================
   EMPTY STATE
================================================== */

.empty-state {

    background: white;

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 50px;

    text-align: center;
}


.empty-state h2 {

    margin-top: 0;
}


.empty-state p {

    color: var(--muted);

    margin-bottom: 20px;
}


/* ==================================================
   SEARCH
================================================== */

.toolbar {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 14px;
}


.toolbar input {

    width: 420px;

    max-width: 100%;

    border: 1px solid var(--border);

    border-radius: 7px;

    background: white;

    padding: 10px 12px;

    outline: none;
}


.toolbar input:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 2px
        rgba(37, 99, 235, .1);
}


.toolbar span {

    color: var(--muted);

    font-size: 13px;
}


/* ==================================================
   TABLE
================================================== */

.table-wrapper {

    background: white;

    border: 1px solid var(--border);

    border-radius: 10px;

    overflow: auto;
}


table {

    width: 100%;

    border-collapse: collapse;

    min-width: 850px;
}


th {

    background: #f9fafb;

    color: #6b7280;

    font-size: 12px;

    text-transform: uppercase;

    letter-spacing: .03em;

    text-align: left;

    padding: 12px;

    border-bottom: 1px solid var(--border);
}


td {

    padding: 13px 12px;

    border-bottom: 1px solid #f0f1f3;

    font-size: 13px;
}


tr:last-child td {

    border-bottom: 0;
}


code {

    background: #f3f4f6;

    padding: 3px 5px;

    border-radius: 4px;

    font-size: 12px;
}


/* ==================================================
   STATUS
================================================== */

.status {

    display: inline-block;

    padding: 4px 8px;

    border-radius: 999px;

    font-size: 11px;

    background: #f3f4f6;

    color: #374151;
}


.status.running,
.status.completed {

    background: #dcfce7;

    color: #166534;
}


.status.stopped {

    background: #fee2e2;

    color: #991b1b;
}


.status.pending {

    background: #fef3c7;

    color: #92400e;
}


/* ==================================================
   FORM
================================================== */

.form-card {

    max-width: 650px;

    background: white;

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 22px;
}


.form-card label {

    display: block;

    margin: 0 0 7px;

    font-size: 13px;

    font-weight: 600;
}


.form-card select,
.form-card textarea {

    width: 100%;

    margin-bottom: 18px;

    border: 1px solid var(--border);

    border-radius: 7px;

    padding: 10px;

    background: white;
}


.form-card textarea {

    min-height: 100px;

    resize: vertical;
}


/* ==================================================
   MODAL
================================================== */

.modal {

    position: fixed;

    inset: 0;

    background:
        rgba(0, 0, 0, .45);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 1000;
}


.modal.show {

    display: flex;
}


.modal-content {

    background: white;

    width: 100%;

    max-width: 560px;

    max-height: 90vh;

    overflow: auto;

    border-radius: 12px;

    padding: 24px;

    box-shadow:
        0 20px 50px
        rgba(0, 0, 0, .2);
}


.modal-header {

    display: flex;

    justify-content: space-between;

    margin-bottom: 20px;
}


.modal-header h2 {

    margin: 0 0 5px;
}


.modal-header p {

    margin: 0;

    color: var(--muted);

    font-size: 12px;
}


.close-button {

    background: transparent;

    border: 0;

    font-size: 25px;

    cursor: pointer;
}


.modal-content label {

    display: block;

    font-size: 13px;

    font-weight: 600;

    margin: 13px 0 6px;
}


.modal-content label span {

    color: var(--muted);

    font-weight: normal;
}


.modal-content input,
.modal-content select {

    width: 100%;

    padding: 10px;

    border: 1px solid var(--border);

    border-radius: 7px;

    background: white;
}


.modal-actions {

    display: flex;

    justify-content: flex-end;

    gap: 8px;

    margin-top: 22px;
}


/* ==================================================
   ACCOUNT LIST
================================================== */

.account-list {

    margin-bottom: 18px;
}


.account-list h3 {

    margin: 0 0 10px;

    font-size: 14px;
}


.account-row {

    display: flex;

    justify-content: space-between;

    align-items: center;

    border: 1px solid var(--border);

    border-radius: 8px;

    padding: 10px 12px;

    margin-bottom: 7px;
}


.account-row.selected {

    border-color: var(--primary);

    background: #eff6ff;
}


.account-row strong {

    display: block;

    font-size: 13px;
}


.account-row small {

    color: var(--muted);

    font-size: 11px;
}


.account-actions {

    display: flex;

    gap: 5px;
}


.small-button {

    background: #eff6ff;

    color: #1d4ed8;

    padding: 6px 9px;

    font-size: 11px;
}


.danger-button {

    background: #fef2f2;

    color: var(--danger);

    padding: 6px 9px;

    font-size: 11px;
}


.muted {

    color: var(--muted);

    font-size: 13px;
}


hr {

    border: 0;

    border-top: 1px solid var(--border);

    margin: 20px 0;
}


/* ==================================================
   RESULT
================================================== */

.success-box {

    margin-top: 18px;

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    color: #166534;

    padding: 16px;

    border-radius: 8px;
}


.no-data {

    background: white;

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 35px;

    color: var(--muted);

    text-align: center;
}


/* ==================================================
   LOADING
================================================== */

.loading {

    position: fixed;

    right: 20px;

    bottom: 20px;

    background: #111827;

    color: white;

    padding: 10px 14px;

    border-radius: 8px;

    display: none;

    align-items: center;

    gap: 8px;

    font-size: 12px;

    z-index: 2000;
}


.loading.show {

    display: flex;
}


.spinner {

    width: 14px;

    height: 14px;

    border: 2px solid #6b7280;

    border-top-color: white;

    border-radius: 50%;

    animation:
        spin .7s linear infinite;
}


@keyframes spin {

    to {
        transform: rotate(360deg);
    }
}


/* ==================================================
   MOBILE
================================================== */

@media (max-width: 900px) {

    .sidebar {

        width: 190px;
    }

    .main {

        margin-left: 190px;

        width:
            calc(100% - 190px);

        padding: 20px;
    }

    .cards {

        grid-template-columns:
            1fr;
    }

    .topbar {

        align-items: flex-start;

        gap: 15px;

        flex-direction: column;
    }

}


@media (max-width: 650px) {

    .sidebar {

        position: static;

        width: 100%;

        min-height: auto;
    }

    .app {

        display: block;
    }

    .main {

        margin-left: 0;

        width: 100%;
    }

    nav {

        flex-direction: row;

        flex-wrap: wrap;
    }

    .menu-item {

        flex: 1;
    }

    .sidebar-bottom {

        margin-top: 15px;
    }

}

