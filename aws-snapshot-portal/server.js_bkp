"use strict";

require("dotenv").config();

const express = require("express");
const path = require("path");
const mysql = require("mysql2/promise");

const {
    EC2Client,
    DescribeInstancesCommand,
    DescribeVolumesCommand,
    DescribeSnapshotsCommand,
    CreateSnapshotCommand,
    CreateTagsCommand
} = require("@aws-sdk/client-ec2");

const {
    STSClient,
    GetCallerIdentityCommand
} = require("@aws-sdk/client-sts");


/* =========================================================
   CONFIGURATION
========================================================= */

const app = express();

const PORT = Number(process.env.PORT || 3000);

const SNAPSHOT_TIMEOUT_HOURS =
    Number(process.env.SNAPSHOT_TIMEOUT_HOURS || 24);

const POLL_INTERVAL_MS =
    Number(process.env.SNAPSHOT_POLL_INTERVAL_MS || 60000);

const DEFAULT_TEAM =
    process.env.SNAPSHOT_TEAM || "SRE-Server-OPS-T2";

const DEFAULT_DELETE_AFTER =
    process.env.SNAPSHOT_DELETE_AFTER || "3Days";


/* =========================================================
   MYSQL
========================================================= */

const pool = mysql.createPool({

    host:
        process.env.MYSQL_HOST ||
        "127.0.0.1",

    port:
        Number(
            process.env.MYSQL_PORT || 3306
        ),

    user:
        process.env.MYSQL_USER ||
        "snapshot_user",

    password:
        process.env.MYSQL_PASSWORD ||
        "",

    database:
        process.env.MYSQL_DATABASE ||
        "aws_snapshot_portal",

    waitForConnections: true,

    connectionLimit: 10,

    queueLimit: 0,

    timezone: "Z"
});


/* =========================================================
   EXPRESS
========================================================= */

app.use(express.json({
    limit: "2mb"
}));

app.use(express.urlencoded({
    extended: true
}));


/*
 * Static files
 */
app.use(
    express.static(
        path.join(__dirname, "public")
    )
);


/* =========================================================
   MYSQL INITIALIZATION
========================================================= */

async function initializeDatabase() {

    const connection =
        await pool.getConnection();

    try {

        await connection.query(`
            CREATE TABLE IF NOT EXISTS snapshot_jobs (

                id BIGINT AUTO_INCREMENT PRIMARY KEY,

                job_id VARCHAR(100) NOT NULL UNIQUE,

                account_name VARCHAR(255),

                region VARCHAR(50) NOT NULL,

                created_by VARCHAR(255),

                description TEXT,

                status VARCHAR(50) NOT NULL DEFAULT 'running',

                total_instances INT DEFAULT 0,

                total_volumes INT DEFAULT 0,

                total_snapshots INT DEFAULT 0,

                completed_snapshots INT DEFAULT 0,

                failed_snapshots INT DEFAULT 0,

                progress DECIMAL(6,2) DEFAULT 0,

                error_message TEXT,

                started_at DATETIME DEFAULT CURRENT_TIMESTAMP,

                completed_at DATETIME NULL,

                updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
                    ON UPDATE CURRENT_TIMESTAMP,

                INDEX idx_job_status (status),

                INDEX idx_job_created (started_at)

            )
        `);


        await connection.query(`
            CREATE TABLE IF NOT EXISTS snapshot_items (

                id BIGINT AUTO_INCREMENT PRIMARY KEY,

                job_id VARCHAR(100) NOT NULL,

                input_value VARCHAR(255),

                instance_name VARCHAR(255),

                instance_id VARCHAR(100),

                volume_id VARCHAR(100),

                snapshot_id VARCHAR(100),

                description TEXT,

                created_by VARCHAR(255),

                created_on VARCHAR(100),

                delete_after VARCHAR(100),

                team VARCHAR(255),

                status VARCHAR(50) NOT NULL DEFAULT 'pending',

                progress INT DEFAULT 0,

                error_message TEXT,

                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,

                updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
                    ON UPDATE CURRENT_TIMESTAMP,

                INDEX idx_item_job (job_id),

                INDEX idx_item_snapshot (snapshot_id),

                INDEX idx_item_instance (instance_id),

                INDEX idx_item_status (status),

                CONSTRAINT fk_snapshot_job
                    FOREIGN KEY (job_id)
                    REFERENCES snapshot_jobs(job_id)
                    ON DELETE CASCADE

            )
        `);

    } finally {

        connection.release();

    }
}


/* =========================================================
   HELPERS
========================================================= */

function generateJobId() {

    return (
        "JOB-" +
        Date.now() +
        "-" +
        Math.random()
            .toString(36)
            .substring(2, 8)
            .toUpperCase()
    );
}


function nowTimestamp() {

    const date = new Date();

    const pad = value =>
        String(value).padStart(2, "0");

    return (
        date.getUTCFullYear() +
        "-" +
        pad(date.getUTCMonth() + 1) +
        "-" +
        pad(date.getUTCDate()) +
        "_" +
        pad(date.getUTCHours()) +
        "-" +
        pad(date.getUTCMinutes()) +
        "-" +
        pad(date.getUTCSeconds())
    );
}


function getAwsConfig(body) {

    if (!body) {
        throw new Error(
            "AWS request body is required."
        );
    }

    const accessKeyId =
        String(
            body.accessKeyId || ""
        ).trim();

    const secretAccessKey =
        String(
            body.secretAccessKey || ""
        ).trim();

    const sessionToken =
        String(
            body.sessionToken || ""
        ).trim();

    const region =
        String(
            body.region || ""
        ).trim();

    if (!accessKeyId) {
        throw new Error(
            "AWS Access Key ID is required."
        );
    }

    if (!secretAccessKey) {
        throw new Error(
            "AWS Secret Access Key is required."
        );
    }

    if (!region) {
        throw new Error(
            "AWS region is required."
        );
    }

    return {

        region,

        credentials: {

            accessKeyId,

            secretAccessKey,

            ...(sessionToken
                ? { sessionToken }
                : {})
        }
    };
}


function createEc2Client(body) {

    const config =
        getAwsConfig(body);

    return new EC2Client(config);
}


function createStsClient(body) {

    const config =
        getAwsConfig(body);

    return new STSClient(config);
}


async function getCreatedBy(body) {

    try {

        const sts =
            createStsClient(body);

        const result =
            await sts.send(
                new GetCallerIdentityCommand({})
            );

        const arn =
            result.Arn || "";

        const parts =
            arn.split("/");

        return (
            parts[parts.length - 1] ||
            result.UserId ||
            "Unknown"
        );

    } catch {

        return "Unknown";
    }
}


function normalizeInput(value) {

    return String(value || "")
        .trim();
}


function isInstanceId(value) {

    return /^i-[a-zA-Z0-9]+$/.test(
        value
    );
}


/* =========================================================
   AWS INSTANCE LOOKUP
========================================================= */

async function findInstance(
    ec2,
    input
) {

    const value =
        normalizeInput(input);

    if (!value) {
        return null;
    }


    /*
     * Direct instance ID
     */
    if (isInstanceId(value)) {

        const result =
            await ec2.send(
                new DescribeInstancesCommand({

                    InstanceIds: [
                        value
                    ]

                })
            );

        for (
            const reservation
            of result.Reservations || []
        ) {

            for (
                const instance
                of reservation.Instances || []
            ) {

                return instance;

            }
        }

        return null;
    }


    /*
     * Instance Name tag.
     *
     * This follows the behavior of the
     * original PowerShell script.
     */
    const result =
        await ec2.send(
            new DescribeInstancesCommand({

                Filters: [

                    {
                        Name:
                            "tag:Name",

                        Values: [
                            value
                        ]
                    },

                    {
                        Name:
                            "instance-state-name",

                        Values: [
                            "running",
                            "stopped"
                        ]
                    }

                ]

            })
        );


    for (
        const reservation
        of result.Reservations || []
    ) {

        for (
            const instance
            of reservation.Instances || []
        ) {

            return instance;

        }
    }


    return null;
}


function getInstanceName(instance) {

    const tag =
        (instance.Tags || [])
            .find(
                item =>
                    item.Key === "Name"
            );

    return (
        tag?.Value ||
        instance.InstanceId ||
        "Unnamed"
    );
}


/* =========================================================
   AWS VOLUME LOOKUP
========================================================= */

async function getInstanceVolumes(
    ec2,
    instance
) {

    const volumeIds = [];

    for (
        const mapping
        of instance.BlockDeviceMappings || []
    ) {

        const volumeId =
            mapping?.Ebs?.VolumeId;

        if (volumeId) {

            volumeIds.push(
                volumeId
            );

        }
    }


    if (!volumeIds.length) {
        return [];
    }


    const result =
        await ec2.send(
            new DescribeVolumesCommand({

                VolumeIds:
                    volumeIds

            })
        );


    return result.Volumes || [];
}


/* =========================================================
   SNAPSHOT TAGS
========================================================= */

async function createSnapshotTags(
    ec2,
    snapshotId,
    item
) {

    await ec2.send(
        new CreateTagsCommand({

            Resources: [
                snapshotId
            ],

            Tags: [

                {
                    Key:
                        "InstanceName",

                    Value:
                        item.instanceName
                },

                {
                    Key:
                        "InstanceId",

                    Value:
                        item.instanceId
                },

                {
                    Key:
                        "VolumeId",

                    Value:
                        item.volumeId
                },

                {
                    Key:
                        "CreatedBy",

                    Value:
                        item.createdBy
                },

                {
                    Key:
                        "CreatedOn",

                    Value:
                        item.createdOn
                },

                {
                    Key:
                        "DeleteAfter",

                    Value:
                        DEFAULT_DELETE_AFTER
                },

                {
                    Key:
                        "Team",

                    Value:
                        DEFAULT_TEAM
                }

            ]

        })
    );
}


/* =========================================================
   UPDATE JOB
========================================================= */

async function updateJobProgress(
    jobId
) {

    const [rows] =
        await pool.query(
            `
            SELECT
                status,
                progress,
                COUNT(*) AS total,
                SUM(
                    CASE
                        WHEN status = 'completed'
                        THEN 1
                        ELSE 0
                    END
                ) AS completed,
                SUM(
                    CASE
                        WHEN status IN (
                            'failed',
                            'error'
                        )
                        THEN 1
                        ELSE 0
                    END
                ) AS failed
            FROM snapshot_items
            WHERE job_id = ?
            GROUP BY status, progress
            `,
            [jobId]
        );


    const [items] =
        await pool.query(
            `
            SELECT
                status,
                progress
            FROM snapshot_items
            WHERE job_id = ?
            `,
            [jobId]
        );


    if (!items.length) {
        return;
    }


    const total =
        items.length;

    const completed =
        items.filter(
            item =>
                item.status ===
                "completed"
        ).length;

    const failed =
        items.filter(
            item =>
                item.status === "failed" ||
                item.status === "error"
        ).length;


    const progress =
        items.reduce(
            (
                totalProgress,
                item
            ) =>
                totalProgress +
                Number(
                    item.progress || 0
                ),
            0
        ) / total;


    let jobStatus =
        "running";


    if (
        completed + failed ===
        total
    ) {

        if (failed === total) {

            jobStatus =
                "failed";

        } else if (failed > 0) {

            jobStatus =
                "completed_with_errors";

        } else {

            jobStatus =
                "completed";

        }
    }


    await pool.query(
        `
        UPDATE snapshot_jobs
        SET
            status = ?,
            total_snapshots = ?,
            completed_snapshots = ?,
            failed_snapshots = ?,
            progress = ?,
            completed_at =
                CASE
                    WHEN ? IN (
                        'completed',
                        'completed_with_errors',
                        'failed'
                    )
                    THEN COALESCE(
                        completed_at,
                        UTC_TIMESTAMP()
                    )
                    ELSE completed_at
                END
        WHERE job_id = ?
        `,
        [
            jobStatus,
            total,
            completed,
            failed,
            progress.toFixed(2),
            jobStatus,
            jobId
        ]
    );
}


/* =========================================================
   UPDATE SNAPSHOT STATUS
========================================================= */

async function syncJobSnapshots(
    body,
    jobId
) {

    const [items] =
        await pool.query(
            `
            SELECT *
            FROM snapshot_items
            WHERE job_id = ?
              AND snapshot_id IS NOT NULL
              AND snapshot_id <> ''
              AND status NOT IN (
                  'completed',
                  'failed',
                  'error'
              )
            `,
            [jobId]
        );


    if (!items.length) {

        await updateJobProgress(
            jobId
        );

        return;

    }


    const ec2 =
        createEc2Client(body);


    const snapshotIds =
        items.map(
            item =>
                item.snapshot_id
        );


    let snapshots = [];


    try {

        const result =
            await ec2.send(
                new DescribeSnapshotsCommand({

                    SnapshotIds:
                        snapshotIds

                })
            );

        snapshots =
            result.Snapshots || [];

    } catch (error) {

        console.error(
            "Snapshot status error:",
            error
        );

        return;
    }


    for (
        const item of items
    ) {

        const snapshot =
            snapshots.find(
                value =>
                    value.SnapshotId ===
                    item.snapshot_id
            );


        if (!snapshot) {
            continue;
        }


        const state =
            snapshot.State ||
            "pending";


        const progress =
            Number(
                snapshot.Progress ||
                0
            );


        let status =
            "pending";


        if (
            state ===
            "completed"
        ) {

            status =
                "completed";

        } else if (
            state ===
            "error"
        ) {

            status =
                "failed";

        } else {

            status =
                "running";
        }


        await pool.query(
            `
            UPDATE snapshot_items
            SET
                status = ?,
                progress = ?,
                error_message = ?
            WHERE id = ?
            `,
            [
                status,
                progress,
                state === "error"
                    ? "AWS snapshot entered error state."
                    : null,
                item.id
            ]
        );
    }


    await updateJobProgress(
        jobId
    );
}


/* =========================================================
   HEALTH
========================================================= */

app.get(
    "/api/health",
    async (req, res) => {

        try {

            await pool.query(
                "SELECT 1"
            );

            res.json({

                success: true,

                mysql:
                    "connected",

                time:
                    new Date()
                        .toISOString()

            });

        } catch (error) {

            res.status(500).json({

                success: false,

                mysql:
                    "error",

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   GET INSTANCES
========================================================= */

app.post(
    "/api/aws/instances",
    async (req, res) => {

        try {

            const ec2 =
                createEc2Client(
                    req.body
                );


            const result =
                await ec2.send(
                    new DescribeInstancesCommand({

                        Filters: [

                            {
                                Name:
                                    "instance-state-name",

                                Values: [
                                    "running",
                                    "stopped"
                                ]
                            }

                        ]

                    })
                );


            const instances = [];


            for (
                const reservation
                of result.Reservations || []
            ) {

                for (
                    const instance
                    of reservation.Instances || []
                ) {

                    const volumes =
                        (
                            instance.BlockDeviceMappings ||
                            []
                        )
                            .filter(
                                mapping =>
                                    mapping?.Ebs?.VolumeId
                            );


                    instances.push({

                        name:
                            getInstanceName(
                                instance
                            ),

                        instanceId:
                            instance.InstanceId,

                        state:
                            instance.State?.Name ||
                            "unknown",

                        instanceType:
                            instance.InstanceType ||
                            "",

                        privateIp:
                            instance.PrivateIpAddress ||
                            "",

                        publicIp:
                            instance.PublicIpAddress ||
                            "",

                        availabilityZone:
                            instance.Placement
                                ?.AvailabilityZone ||
                            "",

                        volumeCount:
                            volumes.length

                    });
                }
            }


            res.json({

                success: true,

                count:
                    instances.length,

                instances

            });

        } catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   GET VOLUMES
========================================================= */

app.post(
    "/api/aws/volumes",
    async (req, res) => {

        try {

            const ec2 =
                createEc2Client(
                    req.body
                );


            const result =
                await ec2.send(
                    new DescribeVolumesCommand({

                        Filters: [

                            {
                                Name:
                                    "status",

                                Values: [
                                    "creating",
                                    "available",
                                    "in-use"
                                ]
                            }

                        ]

                    })
                );


            const volumes =
                (
                    result.Volumes || []
                )
                    .map(
                        volume => {

                            const nameTag =
                                (
                                    volume.Tags ||
                                    []
                                )
                                    .find(
                                        tag =>
                                            tag.Key ===
                                            "Name"
                                    );


                            return {

                                name:
                                    nameTag?.Value ||
                                    "",

                                volumeId:
                                    volume.VolumeId,

                                size:
                                    volume.Size,

                                type:
                                    volume.VolumeType,

                                state:
                                    volume.State,

                                attachedInstance:
                                    volume.Attachments?.[0]
                                        ?.InstanceId ||
                                    "",

                                encrypted:
                                    Boolean(
                                        volume.Encrypted
                                    )

                            };
                        }
                    );


            res.json({

                success: true,

                count:
                    volumes.length,

                volumes

            });

        } catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   GET SNAPSHOTS FROM AWS
========================================================= */

app.post(
    "/api/aws/snapshots",
    async (req, res) => {

        try {

            const ec2 =
                createEc2Client(
                    req.body
                );


            const result =
                await ec2.send(
                    new DescribeSnapshotsCommand({

                        OwnerIds: [
                            "self"
                        ]

                    })
                );


            const snapshots =
                (
                    result.Snapshots || []
                )
                    .map(
                        snapshot => {

                            const tags =
                                snapshot.Tags ||
                                [];


                            const getTag =
                                key =>
                                    tags.find(
                                        tag =>
                                            tag.Key ===
                                            key
                                    )?.Value || "";


                            return {

                                snapshotId:
                                    snapshot.SnapshotId,

                                volumeId:
                                    snapshot.VolumeId,

                                state:
                                    snapshot.State,

                                progress:
                                    snapshot.Progress ||
                                    "0%",

                                size:
                                    snapshot.VolumeSize,

                                startTime:
                                    snapshot.StartTime,

                                description:
                                    snapshot.Description ||
                                    "",

                                instanceName:
                                    getTag(
                                        "InstanceName"
                                    ),

                                instanceId:
                                    getTag(
                                        "InstanceId"
                                    ),

                                createdBy:
                                    getTag(
                                        "CreatedBy"
                                    ),

                                team:
                                    getTag(
                                        "Team"
                                    )

                            };
                        }
                    );


            res.json({

                success: true,

                count:
                    snapshots.length,

                snapshots

            });

        } catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   CREATE MULTI-INSTANCE SNAPSHOTS
========================================================= */

app.post(
    "/api/aws/create-instance-snapshots",
    async (req, res) => {

        try {

            const {

                instances,

                description,

                accountName

            } = req.body;


            if (
                !Array.isArray(instances) ||
                !instances.length
            ) {

                return res.status(400).json({

                    success: false,

                    error:
                        "At least one instance name or ID is required."

                });
            }


            const ec2 =
                createEc2Client(
                    req.body
                );


            const region =
                req.body.region;


            const createdBy =
                await getCreatedBy(
                    req.body
                );


            const jobId =
                generateJobId();


            /*
             * Create the job immediately.
             */
            await pool.query(
                `
                INSERT INTO snapshot_jobs (
                    job_id,
                    account_name,
                    region,
                    created_by,
                    description,
                    status,
                    total_instances
                )
                VALUES (?, ?, ?, ?, ?, 'running', ?)
                `,
                [
                    jobId,
                    accountName || "",
                    region,
                    createdBy,
                    description || "",
                    instances.length
                ]
            );


            let totalVolumes = 0;

            let totalSnapshots = 0;

            const results = [];


            /*
             * Process each manually entered
             * instance.
             */
            for (
                const rawInput
                of instances
            ) {

                const input =
                    normalizeInput(
                        rawInput
                    );


                if (!input) {
                    continue;
                }


                let instance;


                try {

                    instance =
                        await findInstance(
                            ec2,
                            input
                        );

                } catch (error) {

                    results.push({

                        input,

                        status:
                            "Error",

                        error:
                            error.message

                    });

                    continue;
                }


                if (!instance) {

                    results.push({

                        input,

                        status:
                            "InstanceNotFound",

                        instanceName:
                            input,

                        instanceId:
                            "N/A",

                        volumeId:
                            "N/A",

                        snapshotId:
                            "N/A"

                    });

                    continue;
                }


                const instanceId =
                    instance.InstanceId;


                const instanceName =
                    getInstanceName(
                        instance
                    );


                let volumes;


                try {

                    volumes =
                        await getInstanceVolumes(
                            ec2,
                            instance
                        );

                } catch (error) {

                    results.push({

                        input,

                        instanceName,

                        instanceId,

                        status:
                            "VolumeLookupFailed",

                        error:
                            error.message

                    });

                    continue;
                }


                if (!volumes.length) {

                    results.push({

                        input,

                        instanceName,

                        instanceId,

                        volumeId:
                            "N/A",

                        snapshotId:
                            "N/A",

                        status:
                            "NoVolumesFound"

                    });

                    continue;
                }


                totalVolumes +=
                    volumes.length;


                /*
                 * Create one snapshot for every
                 * attached EBS volume.
                 */
                for (
                    const volume
                    of volumes
                ) {

                    const volumeId =
                        volume.VolumeId;


                    const timestamp =
                        nowTimestamp();


                    const snapshotDescription =
                        description?.trim()
                            ? description.trim()
                            : `Volume snapshot of ${instanceName} (${instanceId}) - ${volumeId} - ${timestamp}`;


                    const item = {

                        jobId,

                        input,

                        instanceName,

                        instanceId,

                        volumeId,

                        createdBy,

                        createdOn:
                            timestamp,

                        description:
                            snapshotDescription

                    };


                    try {

                        const snapshotResult =
                            await ec2.send(
                                new CreateSnapshotCommand({

                                    VolumeId:
                                        volumeId,

                                    Description:
                                        snapshotDescription

                                })
                            );


                        const snapshotId =
                            snapshotResult
                                .SnapshotId;


                        if (!snapshotId) {

                            throw new Error(
                                "AWS did not return a SnapshotId."
                            );
                        }


                        /*
                         * Apply tags.
                         */
                        await createSnapshotTags(
                            ec2,
                            snapshotId,
                            item
                        );


                        await pool.query(
                            `
                            INSERT INTO snapshot_items (
                                job_id,
                                input_value,
                                instance_name,
                                instance_id,
                                volume_id,
                                snapshot_id,
                                description,
                                created_by,
                                created_on,
                                delete_after,
                                team,
                                status,
                                progress
                            )
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'running', 0)
                            `,
                            [
                                jobId,
                                input,
                                instanceName,
                                instanceId,
                                volumeId,
                                snapshotId,
                                snapshotDescription,
                                createdBy,
                                timestamp,
                                DEFAULT_DELETE_AFTER,
                                DEFAULT_TEAM
                            ]
                        );


                        totalSnapshots++;


                        results.push({

                            input,

                            instanceName,

                            instanceId,

                            volumeId,

                            snapshotId,

                            status:
                                "SnapshotCreated",

                            progress:
                                0

                        });

                    } catch (error) {

                        console.error(
                            `Snapshot failed for ${volumeId}:`,
                            error
                        );


                        await pool.query(
                            `
                            INSERT INTO snapshot_items (
                                job_id,
                                input_value,
                                instance_name,
                                instance_id,
                                volume_id,
                                description,
                                created_by,
                                created_on,
                                delete_after,
                                team,
                                status,
                                progress,
                                error_message
                            )
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'failed', 0, ?)
                            `,
                            [
                                jobId,
                                input,
                                instanceName,
                                instanceId,
                                volumeId,
                                snapshotDescription,
                                createdBy,
                                timestamp,
                                DEFAULT_DELETE_AFTER,
                                DEFAULT_TEAM,
                                error.message
                            ]
                        );


                        results.push({

                            input,

                            instanceName,

                            instanceId,

                            volumeId,

                            snapshotId:
                                "N/A",

                            status:
                                "SnapshotCreationFailed",

                            error:
                                error.message

                        });
                    }
                }
            }


            await pool.query(
                `
                UPDATE snapshot_jobs
                SET
                    total_volumes = ?,
                    total_snapshots = ?,
                    status = 'running'
                WHERE job_id = ?
                `,
                [
                    totalVolumes,
                    totalSnapshots,
                    jobId
                ]
            );


            await updateJobProgress(
                jobId
            );


            res.json({

                success: true,

                jobId,

                createdBy,

                instanceCount:
                    instances.length,

                volumeCount:
                    totalVolumes,

                snapshotCount:
                    totalSnapshots,

                results

            });


        } catch (error) {

            console.error(
                "Create snapshot error:",
                error
            );


            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   SNAPSHOT JOBS
========================================================= */

app.get(
    "/api/snapshot-jobs",
    async (req, res) => {

        try {

            const limit =
                Math.min(
                    Number(
                        req.query.limit ||
                        100
                    ),
                    500
                );


            const [jobs] =
                await pool.query(
                    `
                    SELECT
                        id,
                        job_id,
                        account_name,
                        region,
                        created_by,
                        description,
                        status,
                        total_instances,
                        total_volumes,
                        total_snapshots,
                        completed_snapshots,
                        failed_snapshots,
                        progress,
                        error_message,
                        started_at,
                        completed_at,
                        updated_at
                    FROM snapshot_jobs
                    ORDER BY started_at DESC
                    LIMIT ?
                    `,
                    [limit]
                );


            res.json({

                success: true,

                jobs

            });

        } catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   SNAPSHOT JOB DETAILS
========================================================= */

app.get(
    "/api/snapshot-jobs/:jobId",
    async (req, res) => {

        try {

            const jobId =
                req.params.jobId;


            const [jobs] =
                await pool.query(
                    `
                    SELECT *
                    FROM snapshot_jobs
                    WHERE job_id = ?
                    LIMIT 1
                    `,
                    [jobId]
                );


            if (!jobs.length) {

                return res.status(404).json({

                    success: false,

                    error:
                        "Snapshot job not found."

                });
            }


            const [items] =
                await pool.query(
                    `
                    SELECT *
                    FROM snapshot_items
                    WHERE job_id = ?
                    ORDER BY id ASC
                    `,
                    [jobId]
                );


            res.json({

                success: true,

                job:
                    jobs[0],

                items

            });

        } catch (error) {

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   SYNC SNAPSHOT JOB WITH AWS
========================================================= */

app.post(
    "/api/snapshot-jobs/:jobId/sync",
    async (req, res) => {

        try {

            const jobId =
                req.params.jobId;


            const [jobs] =
                await pool.query(
                    `
                    SELECT *
                    FROM snapshot_jobs
                    WHERE job_id = ?
                    LIMIT 1
                    `,
                    [jobId]
                );


            if (!jobs.length) {

                return res.status(404).json({

                    success: false,

                    error:
                        "Snapshot job not found."

                });
            }


            await syncJobSnapshots(
                req.body,
                jobId
            );


            const [updatedJobs] =
                await pool.query(
                    `
                    SELECT *
                    FROM snapshot_jobs
                    WHERE job_id = ?
                    LIMIT 1
                    `,
                    [jobId]
                );


            const [items] =
                await pool.query(
                    `
                    SELECT *
                    FROM snapshot_items
                    WHERE job_id = ?
                    ORDER BY id ASC
                    `,
                    [jobId]
                );


            res.json({

                success: true,

                job:
                    updatedJobs[0],

                items

            });

        } catch (error) {

            console.error(error);

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   DASHBOARD SUMMARY
========================================================= */

app.get(
    "/api/snapshot-dashboard",
    async (req, res) => {

        try {

            const [summaryRows] =
                await pool.query(
                    `
                    SELECT

                        COUNT(*) AS total_jobs,

                        COALESCE(
                            SUM(
                                CASE
                                    WHEN status = 'running'
                                    THEN 1
                                    ELSE 0
                                END
                            ),
                            0
                        ) AS running_jobs,

                        COALESCE(
                            SUM(
                                CASE
                                    WHEN status = 'completed'
                                    THEN 1
                                    ELSE 0
                                END
                            ),
                            0
                        ) AS completed_jobs,

                        COALESCE(
                            SUM(
                                CASE
                                    WHEN status IN (
                                        'failed',
                                        'completed_with_errors'
                                    )
                                    THEN 1
                                    ELSE 0
                                END
                            ),
                            0
                        ) AS failed_jobs,

                        COALESCE(
                            SUM(total_snapshots),
                            0
                        ) AS total_snapshots,

                        COALESCE(
                            SUM(completed_snapshots),
                            0
                        ) AS completed_snapshots,

                        COALESCE(
                            SUM(failed_snapshots),
                            0
                        ) AS failed_snapshots

                    FROM snapshot_jobs
                    `
                );


            const [recentJobs] =
                await pool.query(
                    `
                    SELECT
                        job_id,
                        account_name,
                        region,
                        status,
                        total_instances,
                        total_volumes,
                        total_snapshots,
                        completed_snapshots,
                        failed_snapshots,
                        progress,
                        created_by,
                        started_at,
                        completed_at
                    FROM snapshot_jobs
                    ORDER BY started_at DESC
                    LIMIT 50
                    `
                );


            res.json({

                success: true,

                summary:
                    summaryRows[0],

                jobs:
                    recentJobs

            });

        } catch (error) {

            res.status(500).json({

                success: false,

                error:
                    error.message

            });
        }
    }
);


/* =========================================================
   CATCH-ALL
========================================================= */

app.get(
    "*",
    (req, res) => {

        res.sendFile(
            path.join(
                __dirname,
                "public",
                "index.html"
            )
        );
    }
);


/* =========================================================
   START
========================================================= */

async function start() {

    try {

        await initializeDatabase();

        console.log(
            "MySQL database initialized."
        );


        app.listen(
            PORT,
            "0.0.0.0",
            () => {

                console.log(
                    `AWS Snapshot Portal running on port ${PORT}`
                );

                console.log(
                    `http://localhost:${PORT}`
                );

            }
        );

    } catch (error) {

        console.error(
            "Failed to start application:"
        );

        console.error(error);

        process.exit(1);
    }
}


start();
