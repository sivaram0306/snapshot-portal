* {
    box-sizing: border-box;
}

:root {
    --bg: #f5f7fb;
    --sidebar: #101828;
    --sidebar-hover: #1d2939;
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --text: #172033;
    --muted: #667085;
    --border: #e4e7ec;
    --card: #ffffff;
    --success: #12b76a;
    --warning: #f79009;
    --danger: #f04438;
    --purple: #7f56d9;
    --shadow: 0 4px 18px rgba(16, 24, 40, .06);
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--bg);
    color: var(--text);
}

body {
    display: flex;
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar {
    width: 250px;
    min-height: 100vh;
    background: var(--sidebar);
    color: white;
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    z-index: 20;
}

.brand {
    height: 82px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ff9900;
    color: #111827;
    font-weight: 800;
    font-size: 11px;
}

.brand strong {
    display: block;
    font-size: 15px;
}

.brand small {
    display: block;
    margin-top: 3px;
    color: #98a2b3;
    font-size: 11px;
}

.navigation {
    padding: 18px 12px;
}

.nav-item {
    width: 100%;
    border: 0;
    background: transparent;
    color: #cbd5e1;
    text-align: left;
    padding: 12px 14px;
    border-radius: 8px;
    margin-bottom: 5px;
    cursor: pointer;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: .2s;
}

.nav-item:hover {
    background: var(--sidebar-hover);
    color: white;
}

.nav-item.active {
    background: #1d4ed8;
    color: white;
}

.nav-item span {
    width: 20px;
    text-align: center;
    font-weight: 700;
}

.sidebar-footer {
    margin-top: auto;
    padding: 18px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #98a2b3;
    font-size: 11px;
}

.sidebar-footer small {
    display: block;
    margin-top: 4px;
}


/* =====================================================
   MAIN
===================================================== */

.main-content {
    margin-left: 250px;
    width: calc(100% - 250px);
    min-height: 100vh;
}

.topbar {
    min-height: 82px;
    background: white;
    border-bottom: 1px solid var(--border);
    padding: 15px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.page-heading h1 {
    margin: 0;
    font-size: 23px;
}

.page-heading p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.topbar-actions {
    display: flex;
    align-items: end;
    gap: 10px;
}

.account-selector-wrapper,
.region-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.account-selector-wrapper label,
.region-wrapper label {
    font-size: 10px;
    color: var(--muted);
    font-weight: 700;
    text-transform: uppercase;
}

.account-selector-wrapper select {
    min-width: 190px;
}

.region-wrapper select {
    min-width: 145px;
}


/* =====================================================
   PAGES
===================================================== */

.page {
    display: none;
    padding: 28px;
}

.page.active {
    display: block;
}

.page-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
}

.page-toolbar h2 {
    margin: 0;
    font-size: 20px;
}

.page-toolbar p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.toolbar-actions {
    display: flex;
    gap: 8px;
}


/* =====================================================
   SELECTED ACCOUNT
===================================================== */

.selected-account-banner {
    background: linear-gradient(
        135deg,
        #172554,
        #1d4ed8
    );
    color: white;
    border-radius: 12px;
    padding: 18px 22px;
    display: grid;
    grid-template-columns: 1.5fr 1fr auto;
    align-items: center;
    gap: 20px;
    margin-bottom: 22px;
    box-shadow: 0 8px 25px rgba(37,99,235,.18);
}

.banner-label {
    display: block;
    color: #bfdbfe;
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 4px;
}

.selected-account-banner strong {
    font-size: 16px;
}

.connection-status {
    padding: 7px 12px;
    border-radius: 20px;
    background: rgba(255,255,255,.12);
    color: #e2e8f0;
    font-size: 12px;
}

.connection-status.connected {
    background: rgba(18,183,106,.2);
    color: #bbf7d0;
}


/* =====================================================
   BUTTONS
===================================================== */

.btn {
    border: 0;
    border-radius: 7px;
    padding: 9px 14px;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: .2s;
}

.btn.primary {
    background: var(--primary);
    color: white;
}

.btn.primary:hover {
    background: var(--primary-dark);
}

.btn.secondary {
    background: #eef2f6;
    color: #344054;
}

.btn.secondary:hover {
    background: #e4e7ec;
}

.btn.danger {
    background: #fef3f2;
    color: var(--danger);
}


/* =====================================================
   STATS
===================================================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}

.stats-grid:has(.stat-card:nth-child(5)) {
    grid-template-columns: repeat(5, 1fr);
}

.stat-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 13px;
    box-shadow: var(--shadow);
}

.stat-icon {
    width: 43px;
    height: 43px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
}

.stat-card.blue .stat-icon {
    background: #eff6ff;
    color: #2563eb;
}

.stat-card.purple .stat-icon {
    background: #f5f3ff;
    color: var(--purple);
}

.stat-card.orange .stat-icon {
    background: #fff7ed;
    color: #ea580c;
}

.stat-card.green .stat-icon {
    background: #ecfdf3;
    color: var(--success);
}

.stat-card.red .stat-icon {
    background: #fef3f2;
    color: var(--danger);
}

.stat-card span {
    display: block;
    color: var(--muted);
    font-size: 11px;
}

.stat-card strong {
    display: block;
    margin-top: 3px;
    font-size: 22px;
}


/* =====================================================
   DASHBOARD CARDS
===================================================== */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.content-card,
.form-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 20px;
}

.card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
}

.card-header h3 {
    margin: 0;
    font-size: 15px;
}

.card-header p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 11px;
}

.account-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.summary-item {
    background: #f8fafc;
    padding: 13px;
    border-radius: 8px;
}

.summary-item span {
    display: block;
    font-size: 10px;
    color: var(--muted);
}

.summary-item strong {
    display: block;
    margin-top: 5px;
    font-size: 13px;
}

.storage-summary {
    display: flex;
    align-items: center;
    gap: 20px;
}

.storage-number {
    display: flex;
    align-items: baseline;
    gap: 5px;
}

.storage-number strong {
    font-size: 38px;
    color: var(--primary);
}

.storage-number span {
    color: var(--muted);
}

.storage-info span,
.storage-info small {
    display: block;
}

.storage-info span {
    font-size: 12px;
}

.storage-info small {
    margin-top: 4px;
    color: var(--muted);
}


/* =====================================================
   VOLUME SUMMARY
===================================================== */

.volume-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 20px;
}

.mini-stat {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
}

.mini-stat span {
    display: block;
    color: var(--muted);
    font-size: 11px;
}

.mini-stat strong {
    display: block;
    margin-top: 6px;
    font-size: 21px;
}


/* =====================================================
   FORMS
===================================================== */

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 17px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: 12px;
    font-weight: 700;
    color: #344054;
}

.optional {
    color: var(--muted);
    font-weight: 400;
}

input,
select,
textarea {
    width: 100%;
    border: 1px solid #d0d5dd;
    border-radius: 7px;
    background: white;
    color: var(--text);
    padding: 10px 11px;
    font: inherit;
    font-size: 12px;
    outline: none;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(37,99,235,.1);
}

textarea {
    resize: vertical;
}

.form-group small {
    color: var(--muted);
    font-size: 11px;
}

.form-actions,
.modal-actions {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}


/* =====================================================
   TABLE
===================================================== */

.table-container {
    background: white;
    border: 1px solid var(--border);
    border-radius: 11px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

th {
    background: #f8fafc;
    color: #475467;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .03em;
    padding: 12px;
    text-align: left;
    white-space: nowrap;
}

td {
    padding: 12px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    vertical-align: middle;
}

tr:hover td {
    background: #fafcff;
}

code {
    background: #f2f4f7;
    padding: 3px 5px;
    border-radius: 4px;
    font-size: 10px;
    color: #344054;
}


/* =====================================================
   SEARCH
===================================================== */

.filter-bar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 15px;
}

.filter-bar input {
    max-width: 450px;
}

.result-count {
    color: var(--muted);
    font-size: 11px;
}


/* =====================================================
   STATUS
===================================================== */

.status {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: 20px;
    background: #f2f4f7;
    color: #475467;
    font-size: 10px;
    font-weight: 700;
}

.status.running,
.status.completed,
.status.available {
    background: #ecfdf3;
    color: #027a48;
}

.status.error,
.status.failed,
.status.terminated {
    background: #fef3f2;
    color: #b42318;
}

.status.pending {
    background: #fffaeb;
    color: #b54708;
}


/* =====================================================
   EMPTY
===================================================== */

.empty-state {
    min-height: 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--muted);
    font-size: 13px;
}

.empty-state.small {
    min-height: 100px;
}

.muted {
    color: var(--muted);
    font-size: 12px;
}


/* =====================================================
   PREVIEW
===================================================== */

.preview-area {
    margin-top: 20px;
}

.success-box,
.error-box {
    border-radius: 9px;
    padding: 15px;
    margin-top: 14px;
    font-size: 12px;
}

.success-box {
    background: #ecfdf3;
    border: 1px solid #abefc6;
    color: #027a48;
}

.error-box {
    background: #fef3f2;
    border: 1px solid #fecdca;
    color: #b42318;
}

.success-box h3 {
    margin-top: 0;
}

.success-box ul,
.error-box ul {
    margin-bottom: 0;
}


/* =====================================================
   ACCOUNT MODAL
===================================================== */

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(16,24,40,.55);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 100;
}

.modal-overlay.show {
    display: flex;
}

.modal {
    background: white;
    width: min(800px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 14px;
    box-shadow: 0 25px 60px rgba(0,0,0,.2);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20px;
    border-bottom: 1px solid var(--border);
}

.modal-header h2 {
    margin: 0;
    font-size: 18px;
}

.modal-header p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 11px;
}

.modal-close {
    border: 0;
    background: transparent;
    font-size: 26px;
    cursor: pointer;
    color: var(--muted);
}

.account-list-header {
    padding: 15px 20px 8px;
    font-size: 12px;
}

.account-list {
    padding: 0 20px;
}

.account-row {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 8px;
}

.account-row.selected {
    border-color: #84adff;
    background: #f5f8ff;
}

.account-info strong {
    display: block;
    font-size: 13px;
}

.account-info small {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 10px;
}

.account-actions {
    display: flex;
    gap: 6px;
}

.account-actions button {
    border: 0;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
}

.account-use {
    background: #eff6ff;
    color: var(--primary);
}

.account-edit {
    background: #f5f3ff;
    color: var(--purple);
}

.account-remove {
    background: #fef3f2;
    color: var(--danger);
}

.divider {
    height: 1px;
    background: var(--border);
    margin: 15px 20px;
}

.modal-form {
    padding: 0 20px 20px;
}

.modal-form h3 {
    margin: 0 0 15px;
    font-size: 14px;
}


/* =====================================================
   JOB DETAILS
===================================================== */

.job-modal {
    width: min(1100px, 100%);
}

.job-summary {
    padding: 20px;
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
}

.job-summary h2 {
    margin: 0 0 12px;
    font-family: monospace;
    color: var(--primary);
}

.job-summary p {
    margin: 5px 0;
    font-size: 12px;
}


/* =====================================================
   PROGRESS
===================================================== */

.progress {
    width: 100%;
    height: 7px;
    background: #eaecf0;
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: var(--primary);
    border-radius: inherit;
}


/* =====================================================
   LINK BUTTON
===================================================== */

.link-button {
    border: 0;
    background: transparent;
    color: var(--primary);
    cursor: pointer;
    font-family: monospace;
    font-size: 11px;
    padding: 0;
}


/* =====================================================
   LOADING
===================================================== */

.loading-overlay {
    position: fixed;
    inset: 0;
    background: rgba(255,255,255,.7);
    backdrop-filter: blur(2px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
}

.loading-overlay.show {
    display: flex;
}

.loading-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px 28px;
    box-shadow: 0 15px 40px rgba(0,0,0,.12);
    text-align: center;
    font-size: 12px;
}

.spinner {
    width: 28px;
    height: 28px;
    margin: 0 auto 10px;
    border: 3px solid #dbeafe;
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin .7s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}


/* =====================================================
   TOAST
===================================================== */

.toast {
    position: fixed;
    right: 25px;
    bottom: 25px;
    padding: 12px 16px;
    border-radius: 8px;
    color: white;
    background: #344054;
    box-shadow: 0 10px 30px rgba(0,0,0,.15);
    opacity: 0;
    transform: translateY(15px);
    pointer-events: none;
    transition: .25s;
    z-index: 300;
    font-size: 12px;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

.toast.success {
    background: #039855;
}

.toast.error {
    background: #d92d20;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media (max-width: 1200px) {

    .stats-grid,
    .stats-grid:has(.stat-card:nth-child(5)) {
        grid-template-columns: repeat(2, 1fr);
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .topbar-actions {
        width: 100%;
        flex-wrap: wrap;
    }

}

@media (max-width: 900px) {

    .sidebar {
        width: 210px;
    }

    .main-content {
        margin-left: 210px;
        width: calc(100% - 210px);
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .selected-account-banner {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 650px) {

    .sidebar {
        position: static;
        width: 100%;
        min-height: auto;
    }

    body {
        display: block;
    }

    .main-content {
        margin-left: 0;
        width: 100%;
    }

    .navigation {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar-footer {
        display: none;
    }

    .page {
        padding: 15px;
    }

    .stats-grid,
    .stats-grid:has(.stat-card:nth-child(5)),
    .volume-summary-grid,
    .account-summary,
    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .page-toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .topbar-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .account-selector-wrapper select,
    .region-wrapper select {
        width: 100%;
    }
.brand {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 24px 18px;
}

.cloud-logo {
    width: 48px;
    height: 48px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    background:
        radial-gradient(
            circle at 30% 20%,
            #38bdf8,
            #2563eb 55%,
            #312e81
        );

    color: white;
    font-size: 25px;

    box-shadow:
        0 0 0 1px rgba(96,165,250,.2),
        0 8px 25px rgba(37,99,235,.35);
}

.brand-info {
    display: flex;
    flex-direction: column;
}

.brand-info strong {
    color: #fff;
    font-size: 18px;
}

.brand-info span {
    color: #38bdf8;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 3px;
}

.brand-info small {
    margin-top: 5px;
    color: #64748b;
    font-size: 10px;
}
